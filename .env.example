# ---------------------------------------------------------------------------
# Ask Away! configuration. Copy to .env and adjust. Applied on every start.
# Full reference: docs/deployment.md
# ---------------------------------------------------------------------------

# Public URL of your instance (used in emails and QR codes).
APP_URL=https://ask.example.ch

# Database dashboard (/_/) login. Use a long password.
ADMIN_EMAIL=you@example.ch
ADMIN_PASSWORD=change-me-to-something-long

# --- Who may do what -------------------------------------------------------
# EVENT_CREATION: anyone | registered
EVENT_CREATION=anyone
# REGISTRATION: open | closed  (closed = only existing accounts and ADMIN_EMAIL can log in)
REGISTRATION=open
# New events require approval of questions by default (each event can change it).
DEFAULT_MODERATION=true

# --- Email (needed for login and newsletter sign-ups) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true for implicit TLS (usually port 465); STARTTLS on 587 works with false.
SMTP_TLS=false
MAIL_FROM_ADDRESS=noreply@example.ch
MAIL_FROM_NAME=Ask Away!

# --- Reverse proxy ----------------------------------------------------------
# Header your proxy uses for the visitor IP (leave empty if there is no proxy).
TRUSTED_PROXY_HEADERS=X-Forwarded-For

# --- Spam protection ---------------------------------------------------------
QUESTION_MAX_LENGTH=300
QUESTION_COOLDOWN_SECONDS=30
VOTES_PER_MINUTE=60
EVENTS_PER_HOUR_PER_IP=10

# --- Privacy & housekeeping ------------------------------------------------
# Days after an event is closed (or last active) until it's deleted. 0 = never.
RETENTION_DAYS=30
# Database backups into the data volume ("off" to disable).
BACKUP_CRON=0 4 * * *
BACKUP_KEEP=7
LOG_DAYS=3

# Optional: 32 random characters to encrypt stored settings (SMTP password).
# Set it before the first start and never change it afterwards.
PB_ENCRYPTION_KEY=
